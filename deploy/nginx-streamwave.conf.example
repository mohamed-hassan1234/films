# Add these directives to the Nginx server/location that proxies flim.atmaengi.com to the Node API.
# Without client_max_body_size, Nginx commonly rejects video uploads with:
# 413 Request Entity Too Large

server {
  server_name flim.atmaengi.com;

  client_max_body_size 2048m;
  client_body_timeout 1800s;
  proxy_read_timeout 1800s;
  proxy_send_timeout 1800s;
  send_timeout 1800s;

  location /api/ {
    proxy_pass http://127.0.0.1:5001/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Streams the upload to Node instead of buffering very large files on the proxy.
    proxy_request_buffering off;
    proxy_buffering off;
  }

  location /uploads/ {
    proxy_pass http://127.0.0.1:5001/uploads/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
